# 開發時 Vite 會把 /api 轉到本機服務。留空代表使用同一個來源。
VITE_API_BASE_URL=
# api 或 indexeddb。indexeddb 只把範本留在瀏覽器，登入仍走服務。
VITE_TEMPLATE_STORAGE=api

# 服務
HOST=127.0.0.1
PORT=3000
# 相對路徑以 server/ 為準。正式環境請用絕對路徑，例如 /data/app.sqlite。
DATABASE_PATH=data/app.sqlite
# 範本檔案目錄。正式環境請放在 volume，例如 /data/uploads。
UPLOAD_DIR=data/uploads
SESSION_TTL_HOURS=12
# 簽署 session cookie。正式環境至少 32 字元，且不能使用這個示範值。
SESSION_SECRET=dev-only-change-me
# 正式環境請設 NODE_ENV=production，Cookie 會加上 Secure。開發可維持 false。
COOKIE_SECURE=false
NODE_ENV=development
# 逗號分隔的瀏覽器來源。不要使用 *。
# 正式環境的畫面與 /api 在同一個來源時可以留空；額外的來源再用 fly secrets set。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 建置後的前端目錄。開發留空。正式映像預設 /app/dist。
# STATIC_DIR=
# 在反向代理後面時設為 true。Fly 會設成 true。
# TRUST_PROXY=false
MAX_UPLOAD_BYTES=8388608
MAX_ZIP_ENTRIES=64
MAX_ZIP_UNCOMPRESSED_BYTES=33554432
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MINUTE=20

# 示範帳號密碼。正式環境請換成其他值，不要把真實密鑰寫進程式。
SEED_USER_CLERK_PASSWORD=clerk-demo
SEED_USER_ADMIN_PASSWORD=admin-demo
SEED_USER_VIEWER_PASSWORD=viewer-demo
