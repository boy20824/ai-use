# 開發時 Vite 會把 /api 轉到本機服務。留空代表使用同一個來源。
VITE_API_BASE_URL=
# api 或 indexeddb。indexeddb 只把範本留在瀏覽器，登入仍走服務。
VITE_TEMPLATE_STORAGE=api

# 服務
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/app.sqlite
SESSION_TTL_HOURS=12
# 正式環境請設 NODE_ENV=production，Cookie 會加上 Secure。開發可維持 false。
COOKIE_SECURE=false
NODE_ENV=development
# 逗號分隔的瀏覽器來源。不要使用 *。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=8388608
MAX_ZIP_ENTRIES=64
MAX_ZIP_UNCOMPRESSED_BYTES=33554432
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MINUTE=20

# 示範帳號密碼。正式環境請換成其他值，不要把真實密鑰寫進程式。
SEED_USER_CLERK_PASSWORD=clerk-demo
SEED_USER_ADMIN_PASSWORD=admin-demo
SEED_USER_VIEWER_PASSWORD=viewer-demo

# 只在非 production 寫入一份欄位示範範本，不建立案件類別。
# production 即使設為 true 也不會寫入。SEED_DEMO_USERS=true 有同樣效果。
SEED_SAMPLE_DATA=true
VITE_SEED_SAMPLE_DATA=true
